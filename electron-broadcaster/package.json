{
  "name": "wiva-agent",
  "productName": "WIVA",
  "version": "2.6.5",
  "description": "WIVA — Local network live TV, IPTV, and media library agent for hotels, hospitals, cafes, and private networks.",
  "main": "main.cjs",
  "author": {
    "name": "WIVA",
    "email": "support@wiva.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "npm run dev:runtime && electron .",
    "dev:runtime": "node scripts/write-dev-runtime.cjs",
    "dev:repair-native": "electron-builder install-app-deps",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "platform": "node scripts/platform-admin.cjs",
    "platform:apply-schema": "node scripts/platform-admin.cjs apply-schema",
    "platform:list": "node scripts/platform-admin.cjs list all",
    "test": "node scripts/smoke-test.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^12.10.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "39.8.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "app.wiva.agent",
    "productName": "WIVA",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/**/*",
      "library/**/*",
      "licensing/**/*",
      "renderer/**/*",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WIVA-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WIVA"
    },
    "publish": {
      "provider": "github",
      "owner": "Alwahdi",
      "repo": "manara-broadcaster",
      "releaseType": "release"
    }
  }
}
