# Public URL of this Vercel deployment.
WIVA_APP_URL=http://localhost:5280

# Cloud tenant and branding.
WIVA_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_WIVA_BRAND_NAME=WIVA
NEXT_PUBLIC_WIVA_DEMO_MODE=true

# Neon Postgres. Production mutations fail closed when it is missing.
DATABASE_URL=

# Admin login. Generate the hash with: npm run hash-password -- "a-long-password"
WIVA_ADMIN_EMAIL=
WIVA_ADMIN_PASSWORD_HASH=

# At least 32 random bytes. Used for signed sessions and playback grants.
WIVA_SESSION_SECRET=
WIVA_PLAYBACK_SIGNING_SECRET=

# Base64-encoded 32-byte AES key for encrypting provider credentials.
WIVA_CREDENTIALS_KEY=

# Public CDN/media gateway base URL. Never point this at a consumer IPTV account.
WIVA_MEDIA_GATEWAY_URL=

# Optional: demo-only playback uses Apple's public HLS sample.
WIVA_ALLOW_PUBLIC_DEMO_PLAYBACK=true
WIVA_ALLOW_INSECURE_PROVIDER_HTTP=false

# Optional gateway disk bounds for providers that do not support HTTP Range.
WIVA_MAX_VOD_SPOOL_BYTES=8589934592
WIVA_MAX_VOD_SPOOL_TOTAL_BYTES=17179869184
