{
  "name": "wiva-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5280",
    "gateway:local": "node --env-file=.env.local scripts/local-media-gateway.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5280",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/cairo": "^5.2.7",
    "@neondatabase/serverless": "^1.1.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.468.0",
    "next": "^16.0.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
