# WIVA local development environment

# Owner-controlled Neon database used for cloud IPTV/platform activation.
# The legacy name is retained for compatibility with existing release workflows.
MANARA_NEON_DATABASE_URL=

# Optional Sentry project DSN for Electron/main-process error tracking.
SENTRY_DSN=

# Optional legacy/public IPTV cloud fallbacks.
MANARA_CLOUD_URL=
MANARA_SUPABASE_URL=
MANARA_SUPABASE_ANON_KEY=

# Optional IPTV provider import credentials for platform-admin scripts.
HYDRA_IPTV_HOST=
HYDRA_IPTV_USERNAME=
HYDRA_IPTV_PASSWORD=
FIBER_IPTV_HOST=
FIBER_IPTV_USERNAME=
FIBER_IPTV_PASSWORD=

# Future Neon Auth / OAuth integration placeholders.
NEON_AUTH_CLIENT_ID=
NEON_AUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WIVA_AUTH_REDIRECT_URL=
